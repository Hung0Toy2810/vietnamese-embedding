          "locator": "text"
        }
      ],
      "id": "8f2c65999697e93eef420f90"
    },
    {
      "kind": "text_unit",
      "text": "Sản phẩm đổi phải còn nguyên tem và chưa qua sử dụng.",
      "start": 71,
      "end": 124,
      "spans": [
        {
          "start": 71,
          "end": 124,
          "page": null,
          "locator": "text"
        }
      ],
      "id": "fe0c928d6e584f8126489878"
    },
    {
      "kind": "text_unit",
      "text": "Không áp dụng đổi hàng đối với sản phẩm đặt làm theo yêu cầu cá nhân.",
      "start": 125,
      "end": 194,
      "spans": [
        {
          "start": 125,
          "end": 194,
          "page": null,
          "locator": "text"
        }
      ],
      "id": "25fe287d1196df2bc778fd69"
    },
    {
      "kind": "text_unit",
      "text": "Nếu sản phẩm bị lỗi do nhà sản xuất, khách hàng được đổi ngay cả khi đã mở bao bì.",
      "start": 195,
      "end": 277,
      "spans": [
        {
          "start": 195,
          "end": 277,
          "page": null,
          "locator": "text"
        }
      ],
      "id": "1283c1c965eb17ca48e335cd"
    },
    {
      "kind": "text_unit",
      "text": "Nhân viên phải ngắt nguồn điện trước khi vệ sinh máy pha cà phê.",
      "start": 278,
      "end": 342,
      "spans": [
        {
          "start": 278,
          "end": 342,
          "page": null,
          "locator": "text"
        }
      ],
      "id": "f87707281927027285c0b2d5"
    },
    {
      "kind": "text_unit",
      "text": "Không được đổ nước trực tiếp lên bộ phận điện.",
      "start": 343,
      "end": 389,
      "spans": [
        {
          "start": 343,
          "end": 389,
          "page": null,
          "locator": "text"
        }
      ],
      "id": "7b450b2f470e5d7e78124942"
    },
    {
      "kind": "text_unit",
      "text": "Khi phát hiện dây điện hở, nhân viên phải dừng sử dụng máy và báo cho quản lý.",
      "start": 390,
      "end": 468,
      "spans": [
        {
          "start": 390,
          "end": 468,
          "page": null,
          "locator": "text"
        }
      ],
      "id": "068aadfe545e78d6e723c974"
    },
    {
      "kind": "text_unit",
      "text": "Khách hàng cần xuất trình hóa đơn hoặc mã đơn hàng để yêu cầu đổi sản phẩm.",
      "start": 469,
      "end": 544,
      "spans": [
        {
          "start": 469,
          "end": 544,
          "page": null,
          "locator": "text"
        }
      ],
      "id": "223536474e439bf122148fe3"
    },
    {
      "kind": "text_unit",
      "text": "Tiền hoàn lại được chuyển về phương thức thanh toán ban đầu trong vòng năm ngày làm việc sau khi yêu cầu được chấp thuận.",
      "start": 545,
      "end": 666,
      "spans": [
        {
          "start": 545,
          "end": 666,
          "page": null,
          "locator": "text"
        }
      ],
      "id": "49c6cf8ba632115381d1aa83"
    },
    {
      "kind": "text_unit",
      "text": "Thời gian xử lý hoàn tiền không làm thay đổi thời hạn bảy ngày được yêu cầu đổi hàng.",
