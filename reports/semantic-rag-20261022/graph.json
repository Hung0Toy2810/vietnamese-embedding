    {
      "kind": "text_unit",
      "text": "Khách hàng được đổi sản phẩm trong vòng bảy ngày kể từ ngày nhận hàng.",
      "start": 0,
      "end": 70,
      "spans": [
        {
          "start": 0,
          "end": 70,
